# --- Telegram ---
# DIQQAT: bu ALOHIDA bot bo'lishi kerak (@BotFather dan yangi token oling)
BOT_TOKEN=123456:ABC-DEF...
# Telegram webhook'ni himoyalash uchun tasodifiy satr (o'zingiz o'ylab toping)
WEBHOOK_SECRET=change-me-random-string
# Mini App ochiladigan public manzil (Railway domeni), oxirida / bo'lmasin
WEBAPP_URL=https://dxl-erp.up.railway.app

# --- Baza ---
# Faqat shu tizim uchun alohida baza
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dxl_erp

# --- Birinchi admin ---
# O'zingizning Telegram ID raqamingiz (@userinfobot dan bilib olasiz)
SUPERADMIN_TELEGRAM_ID=0

# --- Mintaqa va valyuta ---
TZ=Asia/Tashkent
DEFAULT_USD_UZS=12500

# --- Jadval (24 soatlik format, HH:MM) ---
DAILY_REPORT_TIME=21:00
MORNING_REMINDER_TIME=09:00

# --- Ixtiyoriy ---
LOG_LEVEL=INFO
# Ishga tushganda migratsiyalarni avtomatik qo'llash
AUTO_MIGRATE=1
# Demo ma'lumot bilan to'ldirish (faqat sinov uchun!)
SEED_DEMO=0
