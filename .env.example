# --- Telegram ---
# DIQQAT: bu ALOHIDA bot bo'lishi kerak (@BotFather dan yangi token oling)
BOT_TOKEN=123456:ABC-DEF...
# Telegram webhook'ni himoyalash uchun tasodifiy satr (o'zingiz o'ylab toping)
WEBHOOK_SECRET=change-me-random-string
# Mini App ochiladigan public manzil — Railway bergan HAQIQIY domeningiz.
# https:// bilan boshlansin, oxirida / bo'lmasin. Namuna (o'zingiznikiga almashtiring):
WEBAPP_URL=https://SIZNING-DOMENINGIZ.up.railway.app

# --- Baza ---
# DIQQAT: quyidagi qatorni KO'CHIRMANG — bu shunchaki format namunasi.
# Railway'da qiymat sifatida aynan shuni yozing:  ${{Postgres.DATABASE_URL}}
# (qo'lda yozmang — maydonni tahrirlaganda Railway ro'yxat chiqaradi, o'shandan tanlang)
DATABASE_URL=

# Zaxira: ichki tarmoq ishlamasa ilova shunga o'tadi.
# Railway'da qiymat:  ${{Postgres.DATABASE_PUBLIC_URL}}
DATABASE_PUBLIC_URL=

# --- Birinchi admin ---
# O'zingizning Telegram ID raqamingiz (@userinfobot dan bilib olasiz)
SUPERADMIN_TELEGRAM_ID=0

# --- Mintaqa va valyuta ---
TZ=Asia/Tashkent
DEFAULT_USD_UZS=12500

# --- Jadval (24 soatlik format, HH:MM) ---
DAILY_REPORT_TIME=21:00
MORNING_REMINDER_TIME=09:00

# --- Ixtiyoriy ---
LOG_LEVEL=INFO
# Ishga tushganda migratsiyalarni avtomatik qo'llash
AUTO_MIGRATE=1
# Demo ma'lumot bilan to'ldirish (faqat sinov uchun!)
SEED_DEMO=0
